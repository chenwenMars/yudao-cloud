        <mxCell id="r_9" value="同账号 tag_id 集合" style="html=1;fontFamily=Helvetica;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#8B60A6;strokeWidth=1.1;fontSize=10;fontColor=#8B60A6;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jettySize=auto;orthogonalLoop=1;" parent="g_1" edge="1" source="f_mp_user__tag_ids" target="f_mp_tag__tag_id" relationship="mp_user.tag_ids → mp_tag.tag_id" note="集合元素对应公众号 tag_id 业务编号，非本地 id；还需同 account_id。" evidence="yudao-module-mp/yudao-module-mp-server/src/main/java/cn/iocoder/yudao/module/mp/dal/dataobject/user/MpUserDO.java:96">
