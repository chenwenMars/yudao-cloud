          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="module_notes" value="1. 表结构以 sql/mysql/mp.sql 为准，字段类型包含源码推断；所有连线均为代码支持的逻辑关联。&lt;br&gt;2. 粉丝tag_ids元素关联mp_tag.tag_id且受account_id范围约束；不是mp_tag.id。&lt;br&gt;3. media_id/template_id等微信平台编号不自动关联本地数据库主键。&lt;br&gt;4. mp_tag.id保留DDL非自增INPUT策略，其应用赋值矛盾见DDL推断说明。" style="html=1;fontFamily=Helvetica;fontSize=11;text;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;whiteSpace=wrap;fillColor=#F2F5F9;strokeColor=#D9E0EA;fontColor=#52647B;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="24" y="2194" width="2600" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
