        <mxCell id="r_16" value="biz_type=13" style="html=1;fontFamily=Helvetica;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#8B60A6;strokeWidth=1.1;fontSize=10;fontColor=#8B60A6;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" parent="cross" edge="1" source="f_member_experience_record__biz_id" target="f_trade_order_item__id" relationship="member_experience_record.biz_id → trade_order_item.id" note="ORDER_GIVE_CANCEL_ITEM(13)：单项退款传 orderItem.id；虽读取售后金额，biz_id 不是售后单 id。" evidence="yudao-module-mall/yudao-module-trade-server/src/main/java/cn/iocoder/yudao/module/trade/service/order/handler/TradeMemberPointOrderHandler.java:89">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="module_notes" value="1. 表结构以 sql/mysql/member.sql 为准，字段类型包含源码推断；所有连线均为代码支持的逻辑关联。&lt;br&gt;2. area_id指向内存地区库Area，不存在本次DDL的地区表，不伪造关系。&lt;br&gt;3. 积分/经验流水 biz_id 按已确认业务分支引用签到记录、管理员、交易订单或订单项；字符串值不代表数据库物理外键。经验 ADMIN(0) 分支写常量0，不连接管理员；邀请/抽奖未确认写入目标，不推断关系。" style="html=1;fontFamily=Helvetica;fontSize=11;text;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;whiteSpace=wrap;fillColor=#F2F5F9;strokeColor=#D9E0EA;fontColor=#52647B;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="24" y="1130" width="2600" height="74" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
