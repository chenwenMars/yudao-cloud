        <mxCell id="r_37" value="" style="html=1;fontFamily=Helvetica;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#8B60A6;strokeWidth=1.1;fontSize=10;fontColor=#8B60A6;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" parent="tenancy" edge="1" source="f_pay_notify_task__tenant_id" target="f_system_tenant__id" relationship="pay_notify_task.tenant_id → system_tenant.id" note="公共租户编号，运行时隔离行为还需结合框架配置。" evidence="yudao-framework/yudao-spring-boot-starter-biz-tenant/src/main/java/cn/iocoder/yudao/framework/tenant/core/db/TenantBaseDO.java:19">
