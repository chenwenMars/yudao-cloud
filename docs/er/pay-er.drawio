        <mxCell id="r_38" value="biz_type=5" style="html=1;fontFamily=Helvetica;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#8B60A6;strokeWidth=1.1;fontSize=10;fontColor=#8B60A6;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" parent="cross" edge="1" source="f_pay_wallet_transaction__biz_id" target="f_member_user__id" relationship="pay_wallet_transaction.biz_id → member_user.id" note="UPDATE_BALANCE(5)：后台调整会员钱包余额；biz_id 写入目标会员 userId 的字符串值，钱包固定按 MEMBER 身份获取。" evidence="yudao-module-pay/yudao-module-pay-server/src/main/java/cn/iocoder/yudao/module/pay/controller/admin/wallet/PayWalletController.java:65">
          <mxGeometry relative="1" as="geometry" />
