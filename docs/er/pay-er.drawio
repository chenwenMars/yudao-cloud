          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="module_notes" value="1. 表结构以 sql/mysql/pay.sql 为准，字段类型包含源码推断；所有连线均为代码支持的逻辑关联。&lt;br&gt;2. merchant_*为业务调用方订单号，不存在统一商户订单表；不按相似名称误连。&lt;br&gt;3. 示例spu_id来自演示内置商品数据，不据名称连接商城product_spu。&lt;br&gt;4. 支付通知 data_id 和钱包流水 biz_id 按业务类型分支绘制；充值退款(2)指充值记录，调整余额(5)指会员，转账(6)按实际写入指转账业务单号 no。&lt;br&gt;5. 钱包转账流水存在源码读写矛盾：写入 biz_id 使用 transfer.no，WalletPayClient 成功查询却按 transfer.id 查；ER 图保留此边界，未修改支付业务代码。" style="html=1;fontFamily=Helvetica;fontSize=11;text;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;whiteSpace=wrap;fillColor=#F2F5F9;strokeColor=#D9E0EA;fontColor=#52647B;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="24" y="1807" width="2600" height="106" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
