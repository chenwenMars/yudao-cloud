        <mxCell id="r_97" value="" style="html=1;fontFamily=Helvetica;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#4D76A5;strokeWidth=1.1;fontSize=10;fontColor=#4D76A5;labelBackgroundColor=#FFFFFF;" parent="cross" edge="1" source="f_erp_stock_record__product_id" target="f_erp_product__id" relationship="erp_stock_record.product_id → erp_product.id" note="" evidence="yudao-module-erp/yudao-module-erp-server/src/main/java/cn/iocoder/yudao/module/erp/dal/dataobject/stock/ErpStockRecordDO.java:36">
