        <mxCell id="module_notes" value="1. 表结构以 sql/mysql/system.sql 为准，字段类型包含源码推断；所有连线均为代码支持的逻辑关联。&lt;br&gt;2. OAuth2 client_id关联客户端业务编号client_id，不关联数值主键id。&lt;br&gt;3. user_type=1/2分别指向会员/管理员；根部门/菜单、系统租户套餐使用特殊哨兵值。&lt;br&gt;4. 按新的system.sql列集合绘制；原总SQL多出的tenant_id、操作日志success不自动补回。" style="html=1;fontFamily=Helvetica;fontSize=11;text;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;whiteSpace=wrap;fillColor=#F2F5F9;strokeColor=#D9E0EA;fontColor=#52647B;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="24" y="2568" width="2600" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
